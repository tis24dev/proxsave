### strict-remove-one-fails
strict: true
staged:
  "remote: alpha"
  "\thost alpha.pbs.example"
  "\tauth-id sync@pbs"
  "\tpassword Um03cHctUXo0WGs5LXJlbW90ZS1zZWNyZXQ="
  "\tfingerprint aa:bb:cc"
  ""
answers:
  list -> output "[{\"id\":\"alpha\",\"name\":\"alpha\"},{\"id\":\"beta\",\"name\":\"beta\"},{\"id\":\"gamma\",\"name\":\"gamma\"}]"
  remove beta -> error "injected remove failure"
reads:
  /stage/etc/proxmox-backup/remote.cfg
commands:
  proxmox-backup-manager remote list --output-format=json
  proxmox-backup-manager remote remove beta
  proxmox-backup-manager remote remove gamma
  proxmox-backup-manager remote create alpha --host alpha.pbs.example --auth-id sync@pbs --password Rm7pw-Qz4Xk9-remote-secret --fingerprint aa:bb:cc
error: PBS remote configuration incomplete: 1 stale remote(s) not removed [beta]
error chain: *orchestrator.pbsSectionRestoreIncompleteError -> *errors.errorString
error is: errPBSCleanRemoveIncomplete
log:
  [<TIME>] DEBUG    PBS remote restore: reading current remotes cmd="proxmox-backup-manager remote list --output-format=json"
  [<TIME>] INFO     Restoring PBS remotes...
  [<TIME>] DEBUG    PBS remote restore: mode=clean staged=/stage/etc/proxmox-backup/remote.cfg
  [<TIME>] DEBUG    PBS remote restore: backup remotes=1 names=alpha
  [<TIME>] INFO       Remotes to restore: 1
  [<TIME>] INFO       Names: alpha
  [<TIME>] DEBUG    PBS remote restore: current remotes=3 names=alpha,beta,gamma
  [<TIME>] DEBUG    PBS remote restore: remote=beta not in backup action=remove
  [<TIME>] DEBUG    PBS remote restore: remote=beta remove failed error="injected remove failure"
  [<TIME>] INFO     Remote beta is configured on this PBS but not present in the backup
  [<TIME>] WARNING  ⚠ PBS remote beta: not removed
  [<TIME>] DEBUG    PBS remote restore: remote=gamma not in backup action=remove
  [<TIME>] DEBUG    PBS remote restore: remote=gamma removed
  [<TIME>] INFO     Remote gamma is configured on this PBS but not present in the backup
  [<TIME>] INFO     ✓ PBS remote gamma: removed
  [<TIME>] DEBUG    PBS remote restore: remote=alpha created
  [<TIME>] INFO     ✓ PBS remote alpha: applied
  [<TIME>] WARNING  ⚠ PBS remote configuration: partially applied

