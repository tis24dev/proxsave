### strict-remove-one-fails
strict: true
staged:
  "s3-endpoint: alpha"
  "\tendpoint alpha.s3.example"
  "\tregion eu-central-1"
  "\taccess-key AKx3-Wd8Lp2-s3-access"
  "\tsecret-key Sk5v-Hj6Tn1-s3-secret"
  ""
answers:
  list -> output "[{\"id\":\"alpha\",\"name\":\"alpha\"},{\"id\":\"beta\",\"name\":\"beta\"},{\"id\":\"gamma\",\"name\":\"gamma\"}]"
  remove beta -> error "injected remove failure"
reads:
  /stage/etc/proxmox-backup/s3.cfg
commands:
  proxmox-backup-manager s3 endpoint list --output-format=json
  proxmox-backup-manager s3 endpoint remove beta
  proxmox-backup-manager s3 endpoint remove gamma
  proxmox-backup-manager s3 endpoint create alpha --endpoint alpha.s3.example --region eu-central-1 --access-key AKx3-Wd8Lp2-s3-access --secret-key Sk5v-Hj6Tn1-s3-secret
error: PBS S3 endpoint configuration incomplete: 1 stale S3 endpoint(s) not removed [beta]
error chain: *orchestrator.pbsSectionRestoreIncompleteError -> *errors.errorString
error is: errPBSCleanRemoveIncomplete
log:
  [<TIME>] DEBUG    PBS S3 endpoint restore: reading current s3-endpoints cmd="proxmox-backup-manager s3 endpoint list --output-format=json"
  [<TIME>] INFO     Restoring PBS S3 endpoints...
